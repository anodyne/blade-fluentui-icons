{
    "name": "anodyne/blade-fluentui-icons",
    "description": "A package to easily make use of Heroicons in your Laravel Blade views.",
    "keywords": [
        "Blade",
        "Fluent UI System",
        "Laravel"
    ],
    "homepage": "https://github.com/anodyne/blade-fluentui-icons",
    "license": "MIT",
    "authors": [
        {
            "name": "Anodyne Productions"
        }
    ],
    "require": {
        "php": "^8.1",
        "blade-ui-kit/blade-icons": "^1.5",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "ext-dom": "*",
        "laravel/pint": "^1.0",
        "microsoft/fluentui-system-icons": "1.1.339",
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^1.23|^2.0|^3.0|^4.0"
    },
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "microsoft/fluentui-system-icons",
                "version": "1.1.339",
                "dist": {
                    "url": "https://github.com/microsoft/fluentui-system-icons/archive/refs/tags/1.1.339.zip",
                    "type": "zip"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Anodyne\\FluentUiIcons\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "scripts": {
        "format": "vendor/bin/pint",
        "update-icons": [
            "./bin/compile.sh ./vendor/microsoft/fluentui-system-icons/assets"
        ],
        "test": "vendor/bin/pest --colors=always"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Anodyne\\FluentUiIcons\\BladeFluentUiIconsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
